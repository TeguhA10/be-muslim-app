# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123!
DB_NAME=muslim_database_app
DATABASE_URL=postgresql://postgres:password123!@localhost:5432/muslim_database_app

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_muslim_app_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# External APIs
ALADHAN_API_BASE_URL=
OVERPASS_API_BASE_URL=

# Firebase Cloud Messaging (FCM Push Notifications)
FCM_SERVER_KEY=your_fcm_server_key_here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=test@gmail.com
EMAIL_PASS=**** **** **** ****
EMAIL_FROM_NAME=Muslim App
EMAIL_FROM_ADDRESS=test@gmail.com
