# -----------------------------------------------------------------------------
# Muslim App Backend API Environment Variables (.env.example)
# Copy this file to .env, .env.development, .env.staging, or .env.production
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123!
DB_NAME=muslim_database_app
DATABASE_URL=postgresql://postgres:password123!@localhost:5432/muslim_database_app

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_muslim_app_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Security & CORS Configuration
CORS_ORIGIN=*

# Resend HTTP Email API (Port 443 - 100% Free 3,000 Emails/Month, Immune to ISP Port Block)
# Get your free key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Rate Limiting Parameters (OWASP API4 Protection)
# Window MS: 900000 = 15 minutes (in local dev can be 60000 = 1 minute)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15

# External APIs
ALADHAN_API_BASE_URL=https://api.aladhan.com/v1
OVERPASS_API_BASE_URL=https://overpass-api.de/api/interpreter

# Firebase Cloud Messaging (FCM Push Notifications)
FCM_SERVER_KEY=your_fcm_server_key_here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email SMTP Configuration (Gmail OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=test@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM_NAME=Muslim App
EMAIL_FROM_ADDRESS=test@gmail.com

# Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
