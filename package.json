{
  "name": "be-muslim-app",
  "version": "1.0.0",
  "description": "Backend API for Muslim Application (Prayer Times, Social Feed, Mosque Finder, Qibla)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:staging": "NODE_ENV=staging ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "db:setup": "ts-node src/db/create_database.ts",
    "migration:up": "ts-node src/db/migrate.ts",
    "broadcast": "ts-node src/scripts/broadcast.ts",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "muslim",
    "prayer-times",
    "adzan",
    "qibla",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/sharp": "^0.31.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
